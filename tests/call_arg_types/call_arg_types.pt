out = Keep(v)
    out = v

out = Tag(v)
    out = v ⊕ ["s"]

out = Append(v, item)
    out = v ⊕ [item]

out = Inspect(arr, i)
    arr
    out = i

out = Reset(v)
    v
    out = [v[0:0]]

out = Scores(t)
    out = t.Score ⊕ ["x"]

# A sample names the element type a parameter gives the body.
out, before = Build(n)
    acc = []n
    before = Keep(acc)
    acc = [n]
    out = acc

# Its local shares a name with a caller's destination, which must not change
# how the body types its own calls.
out = Work(n)
    w = []0.0
    Append(w, n)
    out = [n]

a, b = Pair(n)
    a = n
    b = n + 1

first, out = Fold(x, y, current, item)
    first = x + y
    out = current ⊕ [item]
