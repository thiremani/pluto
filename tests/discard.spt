# Blank targets. `_` is a per-slot discard sink, not a binding: it is never
# entered into scope and never typed, so repeated blanks stay independent
# instead of aliasing one shared symbol. A discarded temporary is owned by the
# statement and released; a discarded value read from a named variable is
# borrowed and must survive.

a, u = 3, 4
_ = 1
"Discard: -a"

_, b = FOuter(a, u)
"DiscardFirst: -b"

c, _ = FOuter(a, u)
"DiscardSecond: -c"

p, _, q = FOuter(a, u), 9
"DiscardMiddle: -p -q"

# Blanks at different types in one script: no binding, so no type collision.
_ = "text" ⊕ "value"
_ = 2 * a
"MixedTypes: -a"

# Repeated blanks in one statement, and the same statement twice: each slot is
# its own sink, so the heap outputs are released rather than aliased.
_, _ = twoStr("m", "n")
_, _ = twoStr("o", "p")
"RepeatedBlanks: done"

# A named heap variable survives being discarded — the value is borrowed.
h = "keep" ⊕ "me"
_ = h
_, _ = h, h
"BorrowedSurvives: -h"

# Gated blanks: the taken path drops its value, the skipped path has nothing
# to keep, and neither leaks.
g = 5
_, _ = g > 3 twoStr("x", "y")
_, _ = g > 9 twoStr("x", "y")
"GatedBlank: done"

# Ranged blank: the discarded heap value is released every iteration.
i = 0:3
_ = mkTag(i)
"RangedBlank: done"
