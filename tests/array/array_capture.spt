i = 0:5

arr = [i]
"CaptureLiteral: -arr"

arr1 = []0
arr1 = arr1 ⊕ [i]
"LeftConcat: -arr1"

arr2 = []0
arr2 = [i] ⊕ arr2 ⊕ []0
"RightConcat: -arr2"

arr3 = []0
arr3 = []0⊕ arr3 ⊕ [i]
"LeftConcatExtra: -arr3"

arr4 = [2.3 * i]
"ScaledCapture: -arr4"

j = 1:6:3
arr6 = [3j]
"ScaledWithoutSpace: -arr6"

j = 6:0:-1
arrDesc = [j]
"DescendingCapture: -arrDesc"

arrDescConcat = []0
arrDescConcat = arrDescConcat ⊕ [2j]
"DescendingConcat: -arrDescConcat"

multiRangeCapture = i + [i] - [3j]
"MultiRangeCapture: -multiRangeCapture"

arrBase = [1 2 3 4 5]
rangeSelectionCapture = [arrBase[1:4]]
"RangeSelectionCapture: -rangeSelectionCapture"

rangeSelectionConcat = []0
rangeSelectionConcat = rangeSelectionConcat ⊕ [arrBase[2:5]]
"RangeSelectionConcat: -rangeSelectionConcat"
