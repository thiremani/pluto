arr = [10 20 30]

scalar = 7
scalar = scalar * arr[5]
"ScalarOOBKeepsPrev: -scalar"

negative = 3
negative = negative * arr[-1]
"NegativeOOBKeepsPrev: -negative"

expr = 1
expr = expr + arr[4]
"ExprOOBKeepsPrev: -expr"

newVarOOB = arr[9]
"NewVarOOBDefaultsZero: -newVarOOB"

inBounds = arr[1]
"InBoundsWrites: -inBounds"

tupleScalar, tupleArr = 3, [1 2 arr[9] 5]
"TupleLiteralScalarWrites: -tupleScalar"
tupleArr

cond = 5
cond = arr[5] > 0 99
"CondOOBSkips: -cond"

multi = 100
multi = multi + arr[10] + arr[20]
"MultiOOBSkips: -multi"

farr = [1.5 2.5 3.5]
fkeep = 9.25
fkeep = fkeep + farr[9]
"FloatOOBKeepsPrev: -fkeep"

sarr = ["x" "y"]
skeep = "keep"
skeep = skeep ⊕ sarr[9]
"StringOOBKeepsPrev: -skeep"

arr1 = [10 20 30]
arr2 = [0 2 5]

nestedIn = 99
"NestedSeedIn: -nestedIn"
iIn = 1
nestedIn = arr1[arr2[iIn]]
"NestedBothInBounds: -nestedIn"

nestedOuterOOB = 99
"NestedSeedOuterOOB: -nestedOuterOOB"
iOuterOOB = 2
nestedOuterOOB = arr1[arr2[iOuterOOB]]
"NestedOuterOOBSkips: -nestedOuterOOB"

arr2short = [1]
nestedInnerOOB = 99
"NestedSeedInnerOOB: -nestedInnerOOB"
iInnerOOB = 3
nestedInnerOOB = arr1[arr2short[iInnerOOB]]
"NestedInnerOOBSkips: -nestedInnerOOB"

# a cell past the end zero-fills whatever the read feeds
cellArr = [1 2]
cellPlus = [cellArr[9] + 1]
"CellOOBPlusOne: -cellPlus"

# a comparison fed by a failed read fails in a cell too
cellCmp = [cellArr[9] < 5 && 7]
"CellOOBComparison: -cellCmp"

# so the cell takes its fallback
cellOr = [(cellArr[9] + 1 != 0 && 7) || -1]
"CellOOBFallback: -cellOr"

# a failed row is zeros in the shape its operands show
rowsArr = [1 2]
rowsDiv = [0 1]
rowsRange = 0:3
rowsFill = [rowsArr ÷ rowsDiv[rowsRange] != 0]
"RowsZeroFill: -rowsFill"

# the shape carries through negation and elementwise operators
loneFill = [-(rowsArr + rowsArr) ÷ rowsDiv[9]]
"LoneZeroFill: -loneFill"

# a call doesn't run on a failed row, which takes the shape of the rows that yield
rowsLoud = [Loud(rowsArr ÷ rowsDiv[rowsRange] != 0)]
"RowsSkipCall: -rowsLoud"

# the same in a fixed literal
fixedFill = [Loud(rowsArr + rowsDiv[9]) rowsArr]
"FixedZeroFill: -fixedFill"

# with no row that yields, a call's row shows no shape and stays empty
callRows = [Loud(rowsArr ÷ rowsDiv[rowsRange + 5])]
"CallRowsNoShape: -callRows"

# string rows fill with empty strings
strRows = ["a" "b"]
strFill = [(rowsDiv[rowsRange] != 0) && Loud(strRows)]
"StringRowsFill: -strFill"

# the same in a fixed literal
strFixed = [strRows (rowsDiv[0] != 0) && strRows]
"StringFixedFill: -strFixed"

# a failed check before the rows builds none, so their shapes never meet
outerRows = [[1 1]]
outerRows = (rowsDiv[9] + 1) + [rowsArr [1 2 3]]
"OuterCheckKeepsRows: -outerRows"
