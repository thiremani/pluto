# A statement condition over a ranged call stages through a synthetic slot, and
# the destination is an established rank-2 owner whose flavor differs from the
# call's output. A non-empty driver writes the reset through.
written = [
    1 2
    3 4
]
driver = 0:3
written = 1 > 0 CondReset(driver + 0)
"Written: -written"

# An empty driver yields nothing, so the destination keeps its own matrix. Taking
# the call's flavor here instead empties the destination and leaks its payload.
kept = [
    5 6
    7 8
]
empty = 0:0
kept = 1 > 0 CondReset(empty + 0)
"Preserved: -kept"
