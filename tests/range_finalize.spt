# A bare range name iterates, so assigning one keeps the final value, as an
# operation over it does. Brackets collect every value.
ascendingRange = 0:5
ascending = ascendingRange
ascendingValues = [ascendingRange]
"AscendingLast: -ascending -ascendingValues"

descendingRange = 6:0:-2
descending = descendingRange
"DescendingLast: -descending"

# An empty range runs no iteration: a fresh destination gets zero, and an
# existing one keeps its value.
emptyRange = 3:3
freshEmpty = emptyRange
"EmptyNameFresh: -freshEmpty"

existingEmpty = 91
existingEmpty = emptyRange
"EmptyNameExisting: -existingEmpty"

# Empty ranged computations yield no value: fresh scalar destinations use zero,
# while existing scalar destinations retain their seed.
fresh = emptyRange + 1
"EmptyComputeFresh: -fresh"

existing = 91
existing = emptyRange + 1
"EmptyComputeExisting: -existing"

# A range passed to a function runs it once per value.
callFinal = useShadow(ascendingRange)
"CallFinal: -callFinal"

# A function returns a range's bounds, and the caller builds the range.
boundsStart, boundsStop = rangeBounds()
builtRange = boundsStart:boundsStop
builtValues = [builtRange]
"BuiltRange: -builtValues"

# A marker naming a range iterates it: assigned, the string keeps the final
# value; printed, it prints once per value.
markerRange = 0:3
formattedFinal = "Marker -markerRange"
"MarkerFinal: -formattedFinal"
"MarkerEach -markerRange"

# A width or precision operand iterates a named range the same way.
widthRange = 1:4
widthValue = 7
formattedWidth = "|-widthValue%(-widthRange)d|"
"MarkerWidthFinal: -formattedWidth"
"MarkerWidthEach: |-widthValue%(-widthRange)d|"

# A bare range literal prints as written.
"LiteralDescriptor", 0:3

# The marker and a sibling computation share one driver, so the line prints
# once per value and an explicit %d applies to the element.
"DrivenMarker i=-markerRange%d", markerRange + 0

# A range literal prints its exact bounds, including empty and stepped forms.
"EmptyDescriptor:", 3:3
"SteppedDescriptor:", 6:0:-2

# A range name prints once per value, and an empty one prints nothing.
steppedName = 6:0:-2
"SteppedName:", steppedName
emptyName = 3:3
"EmptyName:", emptyName
"AfterEmptyName"

# Ranged computations preserve simultaneous-assignment reads.
simRange = 0:3
first = 77
first, second = simRange + 0, first
"SimultaneousRange: -first -second"

simArray = [10 20 30]
first = 88
first, second = simArray[simRange], first
"SimultaneousArray: -first -second"

# A marker naming a range iterates it, and the sibling still reads text's
# pre-statement value.
text = "old"
text, otherText = "Marker -markerRange", text
"SimultaneousString: -text -otherText"
