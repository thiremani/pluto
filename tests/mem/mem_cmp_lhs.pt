# A heap string used as a comparison LHS. The comparison must not leave the
# named binding permanently borrowed, or scope cleanup never frees its payload.
out = pickByHeapCompare(k)
    label = "he" ⊕ "llo"
    out = 0
    out = label > "abc" k

# A heap string the comparison builds, an operand that is no binding.
tag = mkTag(v)
    tag = "tag-v"
