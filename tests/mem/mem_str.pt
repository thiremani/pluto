# Helper function that takes a string argument
# This promotes the argument to Ptr type
result = identity(s)
    result = s

# Return a static string literal
s = getStatic()
    s = "static from func"

# Return a static string while consuming a scalar/range argument.
s = getStaticAt(x)
    s = ""
    s = x > -1 "static ranged"

# Start from the caller's value and conditionally replace it with a static string.
s = maybeStatic(prev, flag)
    s = prev
    s = flag > 0 "static changed"

# Write one conditionally chosen static value into two outputs.
s, t = shareStaticOutput(flag)
    shared = flag > 0 "shared static"
    s = shared
    t = shared

# Mixed indirect outputs exercise one widened string slot and one exact scalar slot.
s, n = getStaticPair(x)
    s = ""
    s = x > -1 "pair static"
    n = x

# Return a heap string (concatenation)
s = getHeap()
    s = "heap" ⊕ " from func"

# Access array element inside function and return it
# Tests that: 1) local array is cleaned up, 2) returned string is owned copy
s = getArrayElem(idx)
    arr = ["zero" "one" "two"]
    t = arr[idx]
    s = t

# Use array element inside function without returning it
# Tests that temporary from arr[i] is freed after use
s = useArrayElem()
    arr = ["local" "array" "test"]
    x = arr[0]  # local copy
    y = arr[1]  # another local copy
    s = x ⊕ y   # concat and return

# Return a heap string for conditional-call branch tests
out = condCallHeap(s)
    out = s ⊕ "_cond"
