# A range-gated statement stages its output, and an input keeps its
# argument's value on every iteration, whether it is passed by value or by
# pointer and whether or not its caller shares it with the output.
out = GateInt(current)
    out = current
    out = (1:4) > 0 current + 1

out = GateStr(current)
    out = current
    out = (1:4) > 0 current ⊕ "."

out = GateArr(current)
    out = current
    out = (1:4) > 0 current ⊕ current

out, seen = GateSibInt(current)
    out, seen = current, current
    out, seen = (1:4) > 0 current + 1, current

out, seen = GateSibStr(current)
    out, seen = current, current
    out, seen = (1:4) > 0 current ⊕ ".", current

out = Shrink(arr, v)
    out = [v + arr[0]]

# The loop replaces the output with a shorter array, while every iteration
# indexes the whole input.
out, seen = ShrinkShared(current)
    out = current
    out = Shrink(current, current[(0:8) + 0])
    seen = current

# The conditional stages the output, then the ranged call inside it stages it
# again; the nested call reads the stable input through both.
out, after = GatedFold(current)
    out, after = current, current
    out, after = 1 > 0 FoldAfter(current, (1:3) + 0)
