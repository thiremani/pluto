# Reads in a single assignment precede its output write.
a = 5
a = Twice(a)
a
w = "hi"
w = Shout(w)
w
v = [1 2]
v = Grow(v)
v

# Inputs are stable, so the sequential and simultaneous swaps agree.
sequentialLeft, sequentialRight = 1, 2
sequentialLeft, sequentialRight = SequentialSwap(sequentialLeft, sequentialRight)
"SequentialSwap:", sequentialLeft, sequentialRight
simultaneousLeft, simultaneousRight = 1, 2
simultaneousLeft, simultaneousRight = SimultaneousSwap(simultaneousLeft, simultaneousRight)
"SimultaneousSwap:", simultaneousLeft, simultaneousRight

# Both statement orders, in ordinary and ranged calls.
plainBefore = 10
plainBefore, seenBefore = FoldBefore(plainBefore, 5)
"IntPlainBefore:", plainBefore, seenBefore
plainAfter = 10
plainAfter, seenAfter = FoldAfter(plainAfter, 5)
"IntPlainAfter:", plainAfter, seenAfter
rangeBefore = 10
rangeBefore, rangeSeenBefore = FoldBefore(rangeBefore, 1:3)
"IntRangeBefore:", rangeBefore, rangeSeenBefore
rangeAfter = 10
rangeAfter, rangeSeenAfter = FoldAfter(rangeAfter, 1:3)
"IntRangeAfter:", rangeAfter, rangeSeenAfter
empty = 10
empty, never = FoldAfter(empty, 0:0)
"Empty:", empty, never
separate = 10
separateOut, separateSeen = FoldAfter(separate, 5)
"Separate:", separate, separateOut, separateSeen

# Heap ownership and the static-to-heap specialization regression.
items = ["b" "c"]
heapBefore = "a" ⊕ ""
heapBefore, heapSeenBefore = ConcatBefore(heapBefore, items[0:2])
"HeapRangeBefore:", heapBefore, heapSeenBefore
heapAfter = "a" ⊕ ""
heapAfter, heapSeenAfter = ConcatAfter(heapAfter, items[0:2])
"HeapRangeAfter:", heapAfter, heapSeenAfter
staticText = "hello"
staticText, staticSeen = ConcatAfter(staticText, "abc")
"StaticPlainAfter:", staticText, staticSeen

# Array copies must preserve a value saved before a later append.
arrayBefore = [10]
arrayBefore, arraySeenBefore = ArrayBefore(arrayBefore, 1:3)
"ArrayRangeBefore:", arrayBefore, arraySeenBefore
arrayAfter = [10]
arrayAfter, arraySeenAfter = ArrayAfter(arrayAfter, 1:3)
"ArrayRangeAfter:", arrayAfter, arraySeenAfter

# A nested call shares nothing with its outer caller: its argument and target
# are different bindings in the outer template.
nested = 10
nested, nestedSeen = NestedFold(nested, 5)
"NestedNumber:", nested, nestedSeen
nestedText = "hello" ⊕ ""
nestedText, nestedTextSeen = NestedConcat(nestedText, "abc")
"NestedString:", nestedText, nestedTextSeen
nestedArray = [10]
nestedArray, nestedArraySeen = NestedArrayRange(nestedArray)
"NestedArrayRange:", nestedArray, nestedArraySeen

# A skipped write leaves the shared value unchanged; repeated writes read the
# stable input, and a nested ranged call continues from each result only
# through a binding it shares itself.
taken = 10
taken, takenSeen = ConditionalFold(taken, 5)
"ConditionalTaken:", taken, takenSeen
skipped = 10
skipped, skippedSeen = ConditionalFold(skipped, -1)
"ConditionalSkipped:", skipped, skippedSeen
repeated = 10
repeated = BumpTwice(repeated, 1:3)
"RepeatedWrites:", repeated
nestedRange = 10
nestedRange, nestedRangeSeen = NestedRange(nestedRange)
"NestedRange:", nestedRange, nestedRangeSeen
nestedTwice = 10
nestedTwice, nestedTwiceSeen = NestedRangeTwice(nestedTwice)
"NestedRangeTwice:", nestedTwice, nestedTwiceSeen
nestedArrayTwice = [10]
nestedArrayTwice, nestedArrayTwiceSeen = NestedArrayTwice(nestedArrayTwice)
"NestedArrayTwice:", nestedArrayTwice, nestedArrayTwiceSeen
condNested = 10
condNested, condNestedSeen = ConditionalNested(condNested, 5)
"ConditionalNested:", condNested, condNestedSeen
condNestedSkipped = 10
condNestedSkipped, condNestedSkippedSeen = ConditionalNested(condNestedSkipped, -1)
"ConditionalNestedSkipped:", condNestedSkipped, condNestedSkippedSeen

# A sibling RHS still reads the caller's pre-assignment binding until every
# RHS finishes.
staged = "hello" ⊕ ""
staged, stagedSeen, old = ConcatAfter(staged, "abc"), staged
"StagedString:", staged, stagedSeen, old

# An empty output built from the second input resets the destination without
# changing the unrelated rank, and the second input keeps its value.
flat = [1 2]
matrix = [[3 4]]
matrix, flatSeen, matrixSeen = ResetPair(flat, matrix)
"ResetArray:", matrix, flatSeen, matrixSeen

# The wrapper's static output widens into the caller's heap string after the
# call, and the input keeps its value.
wrapped = "hello" ⊕ "!"
wrapped, wrappedSeen = Wrap(wrapped)
"WidenedWrapper:", wrapped, wrappedSeen

# Without sharing, a static output is converted into the owned destination
# after the call, and an empty output resets the destination.
wideOther = "keep" ⊕ ""
wideSource = "hello" ⊕ "!"
"UnsharedWidenedBefore:", wideOther
wideOther, wideSeen = Tag(wideSource)
"UnsharedWidened:", wideOther, wideSeen, wideSource
resetTarget = [9]
resetSource = [1 2]
"UnsharedResetBefore:", resetTarget
resetTarget, resetLeft, resetRight = ResetPair(resetSource, resetSource)
"UnsharedReset:", resetTarget, resetLeft, resetRight

# An output is readable once definitely assigned, and a sibling output can
# build on it, while a shared input keeps its value. A read string output is
# solved as owned, so the nested call sees the storage the caller holds.
sq, cube = Powers(3)
"Powers:", sq, cube
pw = 3
pw, pwCube = Powers(pw)
"PowersShared:", pw, pwCube
readTwice = "hello" ⊕ "!"
readTwice, readKept, readEcho = ReadTwice(readTwice)
"ReadTwice:", readTwice, readKept, readEcho

# Both arguments name the destination; the nested ranged call reads the
# stable inputs on every iteration, and before keeps the seed.
pair = 10
pair, before = SharedPair(pair, pair)
"SharedPair:", pair, before

condCount = 10
condCount, condCountSeen, condTag = CondCount(condCount)
"CondCount:", condCount, condCountSeen, condTag

bangSource = "ab" ⊕ "cd"
bangCopy = Bang(bangSource)
bangSource = Bang(bangSource)
"Bang:", bangCopy, bangSource

# Ranged heap swaps: each iteration swaps the previous iteration's values,
# whether the callee or the caller runs the loop.
swapLeft, swapRight = [1], [2]
swapLeft, swapRight = SwapEach(swapLeft, swapRight, 1:3)
"RangedSwap:", swapLeft, swapRight
loopLeft, loopRight = [1], [2]
loopLeft, loopRight = SwapEach(loopLeft, loopRight, (1:3) + 0)
"CallerRangedSwap:", loopLeft, loopRight

# Both inputs share the destination, for heap and scalar values.
both = [0]
both = AppendBoth(both, both, 1:3)
"SharedBothArray:", both
bothScalar = 10
bothScalar = AddBoth(bothScalar, bothScalar, 1:3)
"SharedBothScalar:", bothScalar

# Several drivers: nested inside the callee, and a cartesian domain the caller
# runs.
drivers = 10
drivers, driversSeen = FoldAfterBoth(drivers, 1:3, 1:3)
"Drivers:", drivers, driversSeen
driverArray = [0]
driverArray, driverArraySeen = ArrayAfterBoth(driverArray, 1:3, 1:3)
"DriverArray:", driverArray, driverArraySeen
cartesian = 10
cartesian, cartesianSeen = FoldAfter(cartesian, (1:3) + (1:3))
"Cartesian:", cartesian, cartesianSeen

# A failed argument skips its call, and an out-of-bounds element skips its
# iteration, wherever the loop runs.
short = [5 6]
failed = 10
failedSeen = 0
failed, failedSeen = FoldAfter(failed, short[7])
"FailedArgument:", failed, failedSeen
calleeSkip = 10
calleeSkip, calleeSkipSeen = FoldAfter(calleeSkip, short[0:4])
"CalleeSkip:", calleeSkip, calleeSkipSeen
callerSkip = 10
callerSkip, callerSkipSeen = FoldAfter(callerSkip, short[(0:4) + 0])
"CallerSkip:", callerSkip, callerSkipSeen
names = ["b" "c"]
heapSkip = "a" ⊕ ""
heapSkip, heapSkipSeen = ConcatAfter(heapSkip, names[(0:4) + 0])
"HeapCallerSkip:", heapSkip, heapSkipSeen

# An empty range, or one with no element in bounds, runs no iteration and
# keeps every destination.
emptyText = "a" ⊕ ""
emptyTextSeen = "keep"
emptyText, emptyTextSeen = ConcatAfter(emptyText, names[0:0])
"EmptyHeap:", emptyText, emptyTextSeen
outside = "a" ⊕ ""
outsideSeen = "keep"
outside, outsideSeen = ConcatAfter(outside, names[5:7])
"OutOfBounds:", outside, outsideSeen
callerOutside = "a" ⊕ ""
callerOutsideSeen = "keep"
callerOutside, callerOutsideSeen = ConcatAfter(callerOutside, names[(5:7) + 0])
"CallerOutOfBounds:", callerOutside, callerOutsideSeen

# The destination's own array drives the loop: each iteration's input reads
# the previous result while the driver walks the elements.
driven = [1 2]
driven, drivenSeen = ArrayAfter(driven, driven[0:2])
"OwnDriver:", driven, drivenSeen
callerDriven = [1 2]
callerDriven, callerDrivenSeen = ArrayAfter(callerDriven, callerDriven[(0:2) + 0])
"CallerOwnDriver:", callerDriven, callerDrivenSeen

# A conditional ranged call shares through its synthetic destinations.
gatedRange = 10
gatedRange, gatedRangeSeen = 1 > 0 FoldAfter(gatedRange, 1:3)
"GatedRange:", gatedRange, gatedRangeSeen
