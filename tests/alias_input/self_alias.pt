y = Twice(x)
    y = x * 2 + x

s = Shout(t)
    s = t ⊕ "!" ⊕ t

r = Grow(q)
    r = q ⊕ [9] ⊕ q

a, b = SequentialSwap(x, y)
    a = y
    b = x

a, b = SimultaneousSwap(x, y)
    a, b = y, x

# An input keeps its argument's value for the whole call, whatever the
# destinations are, so both statement orders agree.
out, before = FoldBefore(current, item)
    before = current
    out = current + item

out, after = FoldAfter(current, item)
    out = current + item
    after = current

out, before = ConcatBefore(current, item)
    before = current
    out = current ⊕ item

out, after = ConcatAfter(current, item)
    out = current ⊕ item
    after = current

out, before = ArrayBefore(current, item)
    before = current
    out = current ⊕ [item]

out, after = ArrayAfter(current, item)
    out = current ⊕ [item]
    after = current

out, seen = NestedFold(current, item)
    out, seen = FoldAfter(current, item)

out, seen = NestedConcat(current, item)
    out, seen = ConcatAfter(current, item)

# In the body, the input and the output are different bindings, so the
# nested ranged call reads the stable input on every iteration, whether or
# not the outer caller shares.
out, seen = NestedArrayRange(current)
    out, seen = NestedArrayDeep(current, (1:3) + 0)

out, seen = NestedArrayDeep(current, item)
    out, seen = ArrayAfter(current, item)

out, seen = ConditionalFold(current, item)
    out = current
    out = item > 0 current + item
    seen = current

# A nested ranged call accumulates only through a binding its own call site
# shares: the first call reads the stable input on every iteration, and the
# second continues from the output it names as argument and destination.
out, seen = NestedRange(current)
    out, seen = FoldAfter(current, (1:3) + 0)

out, seen = NestedRangeTwice(current)
    out, _ = FoldAfter(current, (1:3) + 0)
    out, seen = FoldAfter(out, (3:5) + 0)

out, seen = NestedArrayTwice(current)
    out, _ = ArrayAfter(current, (1:3) + 0)
    out, seen = ArrayAfter(out, (3:5) + 0)

# A conditional call writes through synthetic destinations that stand in for
# the outputs; the nested call reads the stable input.
out, seen = ConditionalNested(current, item)
    out, seen = current, current
    out, seen = item > 0 FoldAfter(current, item)

out = BumpTwice(current, item)
    out = current + item
    out = out + item

out, seen = Reset(current)
    out = "first"
    seen = current

out, seen = Wrap(current)
    out, seen = Reset(current)

out, seen = Tag(current)
    seen = current
    out = "tagged"

sq, cube = Powers(x)
    sq = x * x
    cube = sq * x

seen = Identity(current)
    seen = current

out, kept, echo = ReadTwice(current)
    out = "first"
    saved = out
    kept = Identity(saved)
    out = "second"
    echo = current

# Two inputs may share one output. SharedPair's nested ranged call names
# neither input as its destination, so it reads both stable inputs on every
# iteration, whether or not SharedPair's caller shares them.
out = AddBoth(a, b, item)
    out = a + item
    out = out + a + b

out, before = SharedPair(a, b)
    before = b
    out = AddBoth(a, b, (1:3) + 0)

# A conditional call promotes its indirect arguments before branching. The
# scalar after a two-valued argument binds a later parameter.
left, right = Tags(n)
    left = "l"
    right = ""
    right = n > 0 "r"

out, tag = Count(left, right, n)
    out = n + 1
    tag = left ⊕ right

out, seen, tag = CondCount(current)
    out, tag = current, ""
    out, tag = 1 > 0 Count(Tags(current), current)
    seen = current

out, left, right = ResetPair(first, second)
    out = [second[0:0]]
    left = first
    right = second

# The body cannot tell whether its caller shares: the input and the output
# have separate storage either way.
out = Bang(current)
    out = current ⊕ "!"
    "storage: -current%p -out%p"

# Every output shares the other output's input, so each iteration swaps the
# previous iteration's heap values.
a, b = SwapEach(x, y, item)
    a = y ⊕ [item]
    b = x

# Both inputs share one output, and each iteration reads the previous result
# through both.
out = AppendBoth(first, second, item)
    out = first ⊕ [item]
    out = out ⊕ second

# Two drivers nest inside the callee, and the input is stable within each of
# their iterations.
out, after = FoldAfterBoth(current, i, j)
    out = current + i * j
    after = current

out, after = ArrayAfterBoth(current, i, j)
    out = current ⊕ [i * j]
    after = current
