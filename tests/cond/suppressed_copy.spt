i = 0:100
v = 0
v = ShowIf([1 2 3], i - i, 3)
w = 0
w = CallIf([1 2 3], i - i, 3)
"ShowCall:", v, w

# Suppressed and running invocations alternate.
j = 0:4
x = 0
x = ShowIf([1 2 3], j - j, j % 2 * 4 + 3)
y = 0
y = CallIf([1 2 3], j - j, j % 2 * 4 + 3)
"ShowCallAlternating:", x, y

o = 0
o = OrPlus([1 2 3], i % 6)
p = 0
p = AndPlus([1 2 3], i % 6)
q = 0
q = MaskPlus([1 2 3], i % 6)
c = [0]
c = CellPlus([1 2 3], i % 6)
"PlusFuncs:", o, p, q, c

e = 0
e = NestedMask([1 2 3], i % 6)
f = 0
f = NestedOr([1 2 3], i % 6)
h = 0
h = NestedAnd([1 2 3], i % 6)
"NestedFuncs:", e, f, h

# When the nested call's condition holds, the call runs.
e2 = NestedMask([1 2 3], 5)
f2 = NestedOr([1 2 3], 5)
h2 = NestedAnd([1 2 3], 5)
"NestedFuncsRun:", e2, f2, h2

# Both branches of the earlier operand, with the later call skipped or run.
g = [0]
g = HeldSibling([1 2 3], i % 2, i % 6)
g1 = HeldSibling([1 2 3], 1, 2)
g2 = HeldSibling([1 2 3], 0, 2)
g3 = HeldSibling([1 2 3], 1, 5)
g4 = HeldSibling([1 2 3], 0, 5)
"HeldSibling:", g, g1, g2, g3, g4

# The print's other argument fails after a sum or a negation consumed the ||
# copy, so nothing prints.
s = 0
s = SumIf([1 2 3], [4 5 6], i - i, 3)
t = 0
t = PairSumIf([1 2 3], [4 5 6], i - i, 3)
r = 0
r = RightSumIf([1 2 3], [4 5 6], i - i, 3)
u = 0
u = NegIf([1 2 3], [4 5 6], i - i, 3)
"IfFuncs:", s, t, r, u

# With the other argument holding, each print runs.
s = SumIf([1 2 3], [4 5 6], 0, 7)
t = PairSumIf([1 2 3], [4 5 6], 0, 7)
r = RightSumIf([1 2 3], [4 5 6], 0, 7)
u = NegIf([1 2 3], [4 5 6], 0, 7)
"IfFuncsPrinted:", s, t, r, u

# Gates, && left sides, || right sides and spine leaves, over both outcomes.
k1 = 5
k1 = GateSum([1 2 3], [4 5 6], i % 6)
k2 = 5
k2 = GateMask([1 2 3], [4 5 6], i % 6)
k3 = 5
k3 = AndSum([1 2 3], [4 5 6], i % 6)
k4 = [0]
k4 = OrSum([1 2 3], [4 5 6], i % 6)
k5 = 0
k6 = 0
k5, k6 = LeafSum([1 2 3], [4 5 6], i % 6)
"CleanupFuncs:", k1, k2, k3, k4, k5, k6
"CleanupFuncsAtZero:", GateSum([1 2 3], [4 5 6], 0), GateMask([1 2 3], [4 5 6], 0), AndSum([1 2 3], [4 5 6], 0), OrSum([1 2 3], [4 5 6], 0), LeafSum([1 2 3], [4 5 6], 0)
