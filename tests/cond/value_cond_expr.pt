res = Double(x)
    res = x * 2

res = CondDouble(x)
    tmp = x > 0
    res = tmp * 2

a, b = Pair(x, y)
    a = x
    b = y

a, b, c = Triple(x, y, z)
    a = x
    b = y
    c = z

a, b = Mix(x)
    a = [x x + 1]
    b = x

res = Id(x)
    res = x

s = MkStr(x)
    s = "s-x"

s = LoudStr(x)
    "called -x"
    s = "s-x"

arr = MkArr(x)
    arr = [x x]

res = Inc(x)
    res = x + 100

p, q = PairStr(x, y)
    p = MkStr(x) ⊕ "!"
    q = MkStr(y) ⊕ "!"

p, q = LitPair()
    p = "zzz"
    q = "bbb"

p, q = LitPair2()
    p = "aaa"
    q = "bbb"

a, b = MixK(x)
    a = [x x]
    b = x + 10

s = Sum3(xs)
    t = xs[0] + xs[1] + xs[2]
    s = t

res = Plus(x)
    res = x

res = Plus(x, y)
    res = x + y

s, t = Swap(x, y)
    s = y
    t = x

r = Cat(a, b)
    r = a ⊕ b
