res = Double(x)
    res = x * 2

res = CondDouble(x)
    tmp = x > 0
    res = tmp * 2

a, b = Pair(x, y)
    a = x
    b = y

a, b, c = Triple(x, y, z)
    a = x
    b = y
    c = z

a, b = Mix(x)
    a = [x x + 1]
    b = x

res = Id(x)
    res = x

s = MkStr(x)
    s = "s-x"

s = LoudStr(x)
    "called -x"
    s = "s-x"

arr = MkArr(x)
    arr = [x x]

res = Inc(x)
    res = x + 100

p, q = PairStr(x, y)
    p = MkStr(x) ⊕ "!"
    q = MkStr(y) ⊕ "!"

p, q = LitPair()
    p = "zzz"
    q = "bbb"

p, q = LitPair2()
    p = "aaa"
    q = "bbb"

a, b = MixK(x)
    a = [x x]
    b = x + 10

s = Sum3(xs)
    t = xs[0] + xs[1] + xs[2]
    s = t

res = Plus(x)
    res = x

res = Plus(x, y)
    res = x + y

s, t = Swap(x, y)
    s = y
    t = x

a, b = Split(x)
    a = x
    b = x + 1

# Whether both of Split's results pass their checks, as one value per call.
ok = Both(x)
    a, b = Split(x)
    ok = 0
    ok = a > 1 && b > 2 1

r = Cat(a, b)
    r = a ⊕ b

r = LoudCat(a, b)
    "called -a -b"
    r = a ⊕ b

# A repeated && side copies the binding's stored string into a slot typed by
# the binding's storage, which the later widening makes heap.
p, q = WidenedRepeat(n)
    s = "a"
    p = "p"
    q = "q"
    p, q = Pair(n, n) >= 0 && s
    s = s ⊕ "b"
    p = p ⊕ s
