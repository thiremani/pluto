# Conditional expression with empty range should be no-op for existing vars.
sum = 42
sum = 1 > 0 sum + 0:-2
"CondExprEmptyExisting: -sum"

# New var with empty-range expression should keep zero value.
newSum = 1 > 0 0 + 0:-2
"CondExprEmptyNew: -newSum"

# Conditional call with empty range should be no-op for existing vars.
acc = 99
acc = 1 > 0 Accum(acc, 0:-2)
"CondCallEmptyExisting: -acc"

# New var from conditional call with empty range should stay zero.
newAcc = 1 > 0 Accum(10, 0:-2)
"CondCallEmptyNew: -newAcc"

# Conditional false keeps existing value and initializes new values.
seed = "seed"
arg = "arg"
seed = 1 > 2 HeapSuffix(arg)
"CondCallFalseHeapExisting: -seed"
fresh = 1 > 2 HeapSuffix(arg)
"CondCallFalseHeapNew: -fresh"

# Function called with literal empty range in conditional context.
x = 7
x = 1 > 0 RangeTail(0:-2)
"CondLiteralRangeExisting: -x"
y = 1 > 0 RangeTail(0:-2)
"CondLiteralRangeNew: -y"

# Mixed outputs: one empty-range no-op and one scalar write.
a, b = 5, 6
a, b = 1 > 0 Accum(a, 0:-2), 123
"CondMixedExisting: -a -b"

m, n = 1 > 0 Accum(1, 0:-2), 123
"CondMixedNew: -m -n"

# A range literal's bounds resolve before its loop, like any operands, so a
# conditional bound works under a gate, in an operation, in a collector and in
# a call.
boundN = 3
boundGated = boundN > 0 0:(boundN > 0 && boundN)
boundOr = boundN > 0 0:(boundN < 0 || 3)
boundSum = 0:(boundN > 0 && boundN) + 0
boundCells = [0:(boundN > 0 && boundN)]
boundCall = 10
boundCall = Accum(boundCall, 0:(boundN > 0 && boundN))
"BoundYields: -boundGated -boundOr -boundSum -boundCells -boundCall"

# A bound that fails to yield leaves the loop with no iterations: existing
# values stay, and a collector gets no cells.
failGated = 7
failGated = boundN > 0 0:(boundN < 0 && boundN)
failSum = 7
failSum = 0:(boundN < 0 && boundN) + 0
failCells = [0:(boundN < 0 && boundN)]
failCall = 10
failCall = Accum(failCall, 0:(boundN < 0 && boundN))
"BoundFails: -failGated -failSum -failCells -failCall"

# Indexing through such a range checks each index as it goes.
boundArr = [10 20 30 40]
boundPick = boundArr[0:(boundN > 0 && boundN)]
failPick = 9
failPick = boundArr[0:(boundN < 0 && boundN)]
"BoundPicks: -boundPick -failPick"
