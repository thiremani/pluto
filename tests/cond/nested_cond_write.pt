# Always writes its output, so any optionality at a call site comes from the
# caller's own argument, not from this body.
res = Sq(v)
    res = v * v

# The same nested-condition shape inside a function body. A .pt template is
# validated before any specialization exists, so this path has no typed
# classification to consult and relies on the syntactic fallback.
out = NestedInBody(x)
    y = 10
    y = (x < 5) + 5
    out = y
