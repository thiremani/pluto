v = [7 0 2 1]
a = v[0]
n = v[1]
m = v[2]
d = [0 2]
e = [1 2]
i = n:3
j = 0:2
k = 0:4

# a filtered divisor leaves the target unchanged
x = 5
x = a ÷ (n != 0)
f = 5.5
f = a / (n != 0)
x, f

# the parentheses around the filter are optional
x = 5
x = a ÷ n != 0
x

# a fallback covers the whole filtered division
x = (a ÷ (n != 0)) || -1
f = (a / (n != 0)) || -1.0
x, f

# without parentheses around the division the fallback becomes the divisor
x = a ÷ (n != 0) || -1
x

# a function's output takes a fallback or a prior value
x = QuoOr(a, n, -1)
y = QuoFrom(a, n)
x, y

# a filtered division inside a comparison leaves the target unchanged
x = 5
x = (a ÷ (n != 0)) > 0
x

# the same for a filtered remainder
x = 5
x = (a % (n != 0)) == 0
x

# arithmetic around the filtered division inside a comparison
x = 5
x = ((a ÷ (n != 0)) + 1) > 0
x

# a fallback around that comparison
x = ((a ÷ (n != 0)) > 0) || -1
x

# the comparison as a statement gate
x = 9
x = (a ÷ (n != 0)) > 0 5
x

# a gate on the statement protects the divide
x = 5
x = n != 0 (a ÷ n) > 0
x

# so does && before it
x = 5
x = n != 0 && a ÷ n
x

# a filtered call argument skips the call
x = 5
x = Quo(a, n != 0)
x

# a filtered divide inside a comparison inside a call
x = 5
x = Id((a ÷ (n != 0)) > 0)
x

# a gate on a call inside a comparison
x = 5
x = n != 0 Quo(a, n) > 0
x

# tuple slots fail one by one inside a comparison
p = 8
q = 9
p, q = Pair(a ÷ (n != 0), 5) > Pair(0, 0)
p, q

# a filtered tuple divide inside a comparison
p = 8
q = 9
p, q = (Pair(a, a) ÷ (Pair(n, m) != Pair(0, 0))) > Pair(0, 0)
p, q

# a loop skips the iteration its filter rejects
s = 0
s = s + 6 ÷ (i != 0)
s

# the same as a statement gate
s = 0
s = (6 ÷ (i != 0)) > 0 s + 1
s

# a collector zero-fills the cell its filter rejects
[6 ÷ (i != 0)]

# the same inside a comparison
[(6 ÷ (i != 0)) > 0]

# a cell can take a fallback
[(6 ÷ (i != 0)) || -1]

# a computed divisor can be zero at run time
t = 0:24
[(t * 3) ÷ ((t % 8) != 0)]

# a long sum skips computed zero divisors
w = 0:1000000
u = 0
u = u + ((w * 3) ÷ ((w % 8) != 0))
u

# an out-of-bounds divisor leaves the target unchanged
x = 5
x = a ÷ v[9]
x

# the same for a remainder
x = 5
x = a % v[9]
x

# the same inside a comparison
x = 5
x = (a ÷ v[9]) > 0
x

# a fallback around that comparison
x = ((a ÷ v[9]) > 0) || -1
x

# an out-of-bounds argument skips the call
x = 5
x = Quo(a, v[9])
x

# a loop skips reads past the end
s = 0
s = s + 7 ÷ e[k]
s

# the same through a call
s = 0
s = s + Quo(7, e[k])
s

# a collector zero-fills cells past the end
[7 ÷ e[k]]

# the same with the range in the index
[7 ÷ e[0:4]]

# the same inside a comparison
[(7 ÷ e[k]) > 0]

# a cell past the end can take a fallback
[((7 ÷ e[k]) > 0) || -1]

# a filtered call argument in a cell skips the call
[Quo(7, e[k] != 0)]

# an array-valued cell past the end zero-fills
[[8 8] ÷ e[9]]

# a per-cell filter divides only the cells it passes
[8 ÷ (d[j] != 0)]

# zeros can be replaced before dividing
z = [d[j] != 0 || -1]
z, [8 8] ÷ z
[8 8] ÷ [d[j] != 0 || 1]

# an array can replace its own zeros
arr = [0 2 -3 0]
g = 0:4
arr = [arr[g] != 0 || -1]
arr

# MIN divided by a replaced -1 doesn't stop
b = -9223372036854775807 - 1
[b b] ÷ z, [b b] % z

# a saved flag protects a later call when it gates it
ok = 1
ok
ok = n != 0 && 1 || 0
x = 5
x = ok == 1 Quo(a, n)
ok, x

# F64 division keeps going
a / n, 7.5 ÷ (n * 1.5), a ÷ (n * 1.5), a % (n * 1.5)
