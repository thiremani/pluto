# literal zero divisors give ±Inf or NaN
a = 7.5 ÷ 0.0
b = -7.5 ÷ 0.0
c = 0.0 ÷ 0.0
a, b, c

# / on I64s gives the same F64 results
d = 7 / 0
e = -7 / 0
f = 0 / 0
d, e, f

# run-time zero divisors give the same results
v = [7.5 0.0]
g = v[0] ÷ v[1]
h = -v[0] / v[1]
i = v[1] / v[1]
g, h, i

# an F64 dividend with an I64 zero divisor stays F64
j = 7.5 ÷ 0
k = 7 ÷ 0.0
j, k

# ÷ truncates x / y toward zero
l = -7.5 ÷ 2.0
m = 7.5 ÷ (1.0 / 0.0)
l, m

# % is fmod-style and takes the dividend's sign
n = -7.5 % 2.0
o = 7.5 % -2.0
p = 5.5 % 2.0
n, o, p

# % with a zero or infinite operand
q = 7.5 % 0.0
r = 7.5 % (1.0 / 0.0)
s = (1.0 / 0.0) % 2.0
q, r, s

# a negative zero keeps its sign through division
z = 0.0 * -1.0
t = 1.0 / z
z, t

# roots give F64
u = √-1
w = ∛-8
x = ∜-16
u, w, x

# ^ follows the math library
aa = 0 ^ 0
ab = 0 ^ -1
ac = 2 ^ 1024
ad = (-8.0) ^ (1 / 3)
aa, ab, ac, ad

# ordered comparisons and == fail for NaN, so the old value stays
nan = 0.0 / 0.0
ae = 5.0
ae = nan == nan
af = 5.0
af = nan < 1.0
ag = 5.0
ag = nan >= 1.0
ah = 5
ah = 1 > nan
ae, af, ag, ah
