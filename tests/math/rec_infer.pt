# A recursive body can use its own call's result before a solver pass has
# typed it: checks on that result wait for the pass that types it.

# The result indexed, and used as an index.
y = Tally(n)
    y = [n]
    y = n > 0 [Tally(n - 1)[0] + 1]

y = Hop(arr, n)
    y = 0
    y = n > 0 arr[Hop(arr, n - 1)]

# A computed index into the result is typed while the result waits.
y = Count(n)
    y = [0]
    y = n > 0 Count(n - 1) ⊕ [Count(n - 1)[n - 1] + 1]

# A field of the result.
ada = Person
  : name age
    "Ada" 36

p = Keep(q, n)
    p = q
    prior = n > 0 Keep(q, n - 1)
    p = prior.age > 0 prior

# The result as a range's start, stop, or step.
y = Down(n)
    y = n
    prior = n > 0 Down(n - 1)
    k = prior:5
    y = y + k

y = Tri(n)
    y = n
    prior = n > 0 Tri(n - 1)
    k = 0:prior
    y = y + k

y = Skip(n)
    y = n
    prior = n > 0 Skip(n - 1)
    k = 0:6:(prior + 1)
    y = y + k

# A comparison of the result as the left operand of || and &&.
y = Clamp(x, n)
    prior = n > 0 Clamp(x - 1, n - 1)
    y = prior > 2 || x

y = Gate(x, n)
    y = x
    prior = n > 0 Gate(x - 1, n - 1)
    y = prior > 2 && x + 10

# A table cell keeps only its own column pending: the float the result
# promotes the column to reaches the output read from it, and another column
# still types its output.
y, z = Mixed(n)
    y = 0.5
    prior, _ = n > 0 Mixed(n - 1)
    tab = [
        :a
        1
        prior
    ]
    z = tab.a[0]

y = Pick(n, x)
    prior = n > 0 Pick(n - 1, x)
    tab = [
        :a b
        prior x
    ]
    y = tab.b[0]

# Operators wait for a column the result still leaves pending.
y = Bump(n, x)
    y = x
    prior = n > 0 Bump(n - 1, x)
    tab = [
        :a
        prior
    ]
    col = tab.a + 1
    y = n > 0 col[0] + x

y = BumpRight(n, x)
    y = x
    prior = n > 0 BumpRight(n - 1, x)
    tab = [
        :a
        prior
    ]
    col = 1 + tab.a
    y = n > 0 col[0] + x

y = Flip(n, x)
    y = x
    prior = n > 0 Flip(n - 1, x)
    tab = [
        :a
        prior
    ]
    col = -tab.a
    y = n > 0 col[0] + x

y = Pad(n, x)
    prior = n > 0 Pad(n - 1, x)
    tab = [
        :a
        prior
    ]
    col = x > 3 && tab.a || [x]
    y = col[0] + 1

y = PadRight(n, x)
    prior = n > 0 PadRight(n - 1, x)
    tab = [
        :a
        prior
    ]
    col = x > 3 && [x] || tab.a
    y = col[0] + 1

# A computed index into a pending column is typed while the column waits.
y = ColumnAt(n, x)
    y = x
    prior = n > 0 ColumnAt(n - 1, x)
    tab = [
        :a
        prior
        x
    ]
    y = n > 0 tab.a[n - 1] + 1
