# A recursive body can use its own call's result before a solver pass has
# typed it: checks on that result wait for the pass that types it. Each
# program prints a different value if its recursion does not run.

# The result indexed, and used as an index.
y = Tally(n)
    y = [0]
    y = n > 0 [Tally(n - 1)[0] + 1]

y = Hop(arr, n)
    y = 0
    y = n > 0 arr[Hop(arr, n - 1)]

# A computed index into the result is typed while the result waits.
y = Count(n)
    y = [0]
    y = n > 0 Count(n - 1) ⊕ [Count(n - 1)[n - 1] + 1]

# A field of the result. The level count shows every level passed the check.
ada = Person
  : name age
    "Ada" 36

p, levels = Keep(q, n)
    p = q
    levels = 0
    prior, below = n > 0 Keep(q, n - 1)
    levels = prior.age > 0 below + 1

# The result as a range bound.
y = Tri(n)
    y = n
    prior = n > 0 Tri(n - 1)
    k = 0:prior
    y = y + k

# A comparison of the result as the left operand of ||.
y = Clamp(x, n)
    prior = n > 0 Clamp(x - 1, n - 1)
    y = prior > 2 || x

# A table cell holding the result keeps its column pending until the result
# promotes it to float, and the output read from the column sees the float.
y, z = Mixed(n)
    y = 0.5
    prior, _ = n > 0 Mixed(n - 1)
    tab = [
        :a
        1
        prior
    ]
    z = tab.a[0] + tab.a[1]

# An operator waits for a column the result still leaves pending.
y = Bump(n, x)
    y = x
    prior = n > 0 Bump(n - 1, x)
    tab = [
        :a
        prior
    ]
    col = tab.a + 1
    y = n > 0 col[0] + x

# Mutual recursion: a result waits the same way when it comes from another
# function in the cycle.
y = Ping(n)
    y = [0]
    y = n > 0 [Pong(n - 1)[0] + 1]

y = Pong(n)
    y = [0]
    y = n > 0 [Ping(n - 1)[0] + 2]

# A three-function cycle, with the result as an index.
y = HopA(arr, n)
    y = 0
    y = n > 0 arr[HopB(arr, n - 1)]

y = HopB(arr, n)
    y = 0
    y = n > 0 arr[HopC(arr, n - 1)]

y = HopC(arr, n)
    y = 0
    y = n > 0 arr[HopA(arr, n - 1)]
