# Test function calls in print with range iteration

# Simple function call
Square(3)

# Function with range - iterates and calls per value
m = 0:3
m + 1, Square(m)

# Inline range in function call
Square(1:4)

# Named range in function call
i = 0:4
Square(i)

# Named range both direct and in function call
i, Square(i)

# Two bare ranges print as descriptor values on one line.
j = 1:3
i, j

# A computation drives only its own name; the undriven bare range stays a
# descriptor, printed once per driver yield.
i, j + 1

# The undriven bare range prints its descriptor beside each computed value.
i, Square(j + 1)

# Same driver bare and in a computation - the computation binds it, single loop
j, Square(j + 1)

# Regression test: mixed expression with function not called with scalars before
# SumSquares(k, k) creates Range variant, but k+1 forces iteration needing scalar variant
k = 0:2
k + 1, SumSquares(k, k)
