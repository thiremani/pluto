res = UpperTriRowTail(a, n, i)
    j = (i + 1):n
    t = a[i * n + j]
    res = t

# A range that arrives through a call may be empty, so the output starts from
# prev, and an empty range keeps the caller's value.
r = MakeRange(n)
    r = 0:n

out = DoubleLast(prev, n)
    r = MakeRange(n)
    out = prev
    out = r * 2

# A call under && or || passes on each of its outputs whole, so a range in one
# of several outputs stays a range.
r, k = Two(n)
    r, k = 0:n, n

out = AndTwo(n)
    kept, k = n > 0 && Two(n)
    out = [kept] ⊕ [k]

out = OrTwo(n)
    kept, k = Two(n > 0) || Two(3)
    out = [kept] ⊕ [k]
