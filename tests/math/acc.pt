res = Id(x)
    res = x

res = AccViaId(a, x)
    tmp = Id(a)
    res = tmp + x

res = Acc(a, x)
    res = a + x

res = ConditionalAcc(a, x)
    res = a
    res = x > 0 a + x

# A filter keeps its value through prev. Shared, each iteration starts from the
# value the last one kept; unshared, each starts from the same prev.
res = Filter(prev, x)
    res = prev
    res = x < 3 x

sum, last = AccPair(a, x)
    sum = a + x
    last = x

# Sibling first, so the accumulator sits at the second output and its selector
# keeps the skipped first output as a numbering gap.
half, sum = ReversedAcc(a, x)
    half = x * 0.5
    sum = a + x
